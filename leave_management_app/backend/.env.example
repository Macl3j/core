# Database Configuration
# For SQLite (default):
DATABASE_URL=sqlite:///./leave_management.db

# For PostgreSQL:
# DATABASE_URL=postgresql://user:password@localhost:5432/leave_management

# For MySQL:
# DATABASE_URL=mysql+pymysql://user:password@localhost:3306/leave_management

# JWT Secret Key (CHANGE THIS IN PRODUCTION!)
SECRET_KEY=your-secret-key-change-this-in-production-use-random-string

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000

# Email Configuration (SMTP)
EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=noreply@leavemanagement.com
SMTP_FROM_NAME=Leave Management System

# Email Configuration Examples:
# Gmail: smtp.gmail.com:587 (requires app password: https://support.google.com/accounts/answer/185833)
# Outlook: smtp-mail.outlook.com:587
# Office365: smtp.office365.com:587
# Yahoo: smtp.mail.yahoo.com:587
# SendGrid: smtp.sendgrid.net:587 (use API key as password)
